{
  "name": "srcery-terminal",
  "version": "0.4.0",
  "description": "Build terminal configurations for the srcery color scheme",
  "type": "module",
  "main": "builder",
  "scripts": {
    "lint": "eslint .",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/srcery-colors/srcery-terminal.git"
  },
  "keywords": [
    "configuration",
    "terminal",
    "colorscheme"
  ],
  "author": "Daniel Berg",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/srcery-colors/srcery-terminal/issues"
  },
  "homepage": "https://github.com/srcery-colors/srcery-terminal#readme",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@srcery-colors/srcery-palette": "2.0.0",
    "commander": "15.0.0",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "handlebars": "4.7.9"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12",
      "onFail": "download"
    }
  }
}
