{
  "name": "srcery-terminal",
  "version": "0.5.0",
  "description": "Build terminal configurations for the srcery color scheme",
  "type": "module",
  "main": "bin/builder.ts",
  "scripts": {
    "check": "node bin/builder.ts --check",
    "formats": "node bin/builder.ts --list",
    "generate": "node bin/builder.ts",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm typecheck && pnpm lint && pnpm check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/srcery-colors/srcery-terminal.git"
  },
  "keywords": [
    "configuration",
    "terminal",
    "colorscheme"
  ],
  "author": "Daniel Berg",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/srcery-colors/srcery-terminal/issues"
  },
  "homepage": "https://github.com/srcery-colors/srcery-terminal#readme",
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@srcery-colors/srcery-palette": "2.1.1",
    "@types/node": "26.6.10",
    "typescript": "7.0.2"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26.13.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": ">=12.0.0 <13.0.0"
    }
  }
}
